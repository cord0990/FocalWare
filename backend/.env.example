# Copiar este archivo como .env y completar con los datos de cada uno.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=focalware
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# URL que usa Prisma (las variables de arriba se embeben acá).
DATABASE_URL="postgresql://postgres:tu_contraseña@localhost:5432/focalware"

# Dirección del frontend que puede usar la API (CORS)
FRONTEND_URL=http://localhost:5173
