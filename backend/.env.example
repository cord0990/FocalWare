# Copiar este archivo como .env y completar con los datos de cada uno.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL. Estos valores son los de la base de Docker.
# Si usas el PostgreSQL instalado en Windows, cambia el puerto a 5432 y pon tu contraseña.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=focalware
DB_USER=postgres
DB_PASSWORD=postgres

# URL que usa Prisma. No toma los valores de arriba solos: si cambias la
# contraseña o el puerto, hay que cambiarlos también aquí.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/focalware"

# Dirección del frontend que puede usar la API (CORS)
FRONTEND_URL=http://localhost:5173

# Token de sesión (JWT). La clave secreta debe ser larga y no se comparte.
JWT_SECRETO=cambia_esta_clave
JWT_EXPIRACION=15m
