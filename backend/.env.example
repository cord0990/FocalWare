# Copiar este archivo como .env y completar con los datos de cada uno.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL. Estos valores son los de la base de Docker.
# Si usas el PostgreSQL instalado en Windows, cambia el puerto a 5432 y pon tu contraseña.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=focalware
DB_USER=postgres
DB_PASSWORD=postgres

# URL que usa Prisma. No toma los valores de arriba solos: si cambias la
# contraseña o el puerto, hay que cambiarlos también aquí.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/focalware"

# Dirección del frontend que puede usar la API (CORS)
FRONTEND_URL=http://localhost:5173

# Token de sesión (JWT). La clave secreta debe tener al menos 32 caracteres.
# En Docker, si se deja vacía, la API genera una aleatoria y la guarda en el volumen focalware_appdata.
# Fuera de Docker hay que completarla.
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRACION=15m

# Poner 1 solo si la API está detrás de un proxy inverso.
# Así el límite de intentos por IP evita usar la IP del proxy.
TRUST_PROXY=0
