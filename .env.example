# Variables opcionales para Docker Compose.
# Copiar este archivo como .env en la raíz solo si se quieren cambiar los valores por defecto.
# Docker Compose funciona sin este archivo.

# Contraseña de PostgreSQL.
# La usan el servicio db y el DATABASE_URL de la API.
DB_PASSWORD=postgres

# Puerto publicado en el equipo para PostgreSQL.
# Dentro de la red de Docker la API siempre usa db:5432.
DB_PORT=5434

# Origen permitido por CORS.
FRONTEND_URL=http://localhost:5173

# Duración de los tokens JWT.
JWT_EXPIRACION=15m

# Clave para firmar los tokens. Debe tener al menos 32 caracteres.
# Generar una con: openssl rand -hex 32
# JWT_SECRETO=...
